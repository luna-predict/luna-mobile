{
  "name": "lunapredict-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@qvac/sdk": "^0.22.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bare-kit": "^0.16.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --profile preview --platform android",
    "build:dev": "eas build --profile development --platform android"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/.*/fixtures.ts$"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native))"
    ]
  },
  "overrides": {
    "expo-asset": "$expo-asset",
    "expo-constants": "$expo-constants"
  }
}
